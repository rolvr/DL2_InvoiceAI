# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.ipynb_checkpoints/
.venv/
venv/
env/

# --- Data (raw/interim/processed are large & dataset-license-bound; do not commit) ---
data/raw/**
!data/raw/.gitkeep
data/interim/**
!data/interim/.gitkeep
data/processed/**
!data/processed/.gitkeep
data/ocr_text/**
!data/ocr_text/.gitkeep

# Keep annotation CSVs (small, hand-curated) but ignore any large exports
data/annotations/*.zip

# --- Models (large binary artifacts; track via README + release, not git) ---
models/**/*.pt
models/**/*.pth
models/**/*.h5
models/**/*.onnx
models/**/*.weights
models/**/checkpoints/

# --- Kaggle credentials — NEVER commit ---
kaggle.json
.kaggle/

# --- Outputs (regenerated by notebooks; keep folder structure only) ---
outputs/figures/*.png
outputs/predictions/*.csv
outputs/metrics/*.json
outputs/final_json/**/*.json
!outputs/**/.gitkeep

# --- Streamlit ---
.streamlit/secrets.toml

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Env ---
.env
