{
  "default_required_fields": [
    {
      "field_name": "PO Reference",
      "required": true,
      "keywords": [
        "purchase order",
        "p.o.",
        "po no",
        "po number",
        "po ref"
      ],
      "patterns": [
        "\\bPO[-\\s#:]?\\d{2,}",
        "\\bP\\.O\\.[-\\s#:]*\\d{2,}"
      ]
    },
    {
      "field_name": "Order Number",
      "required": true,
      "keywords": [
        "order number",
        "order no.",
        "sales order"
      ],
      "patterns": [
        "\\bORD[-\\s#:]?\\d{2,}",
        "\\border\\s*(?:no\\.?|number|#|:)\\s*[-#:]?\\s*\\d{2,}"
      ]
    },
    {
      "field_name": "Contract Number",
      "required": false,
      "keywords": [
        "contract no",
        "contract number",
        "agreement no"
      ],
      "patterns": [
        "\\bCN[-\\s#:]?\\d{2,}",
        "\\bcontract\\s*(?:no\\.?|#|:)\\s*\\d{2,}"
      ]
    },
    {
      "field_name": "Work Order No.",
      "required": false,
      "keywords": [
        "work order",
        "job order"
      ],
      "patterns": [
        "\\bWO[-\\s#:]?\\d{2,}",
        "\\bJOB[-\\s#:]?\\d{2,}"
      ]
    },
    {
      "field_name": "Project Reference",
      "required": false,
      "keywords": [
        "project ref",
        "project number",
        "project code"
      ],
      "patterns": [
        "\\bPRJ[-\\s#:]?\\d{2,}",
        "\\bproject\\s*(?:no\\.?|#|code|:)\\s*\\d{2,}"
      ]
    },
    {
      "field_name": "Insurance Policy Number",
      "required": false,
      "keywords": [
        "insurance policy",
        "policy no",
        "policy number"
      ],
      "patterns": [
        "\\bpolicy\\s*(?:no\\.?|number|#|:)\\s*[-#:]?\\s*[A-Z0-9][A-Z0-9-]{3,}"
      ]
    },
    {
      "field_name": "Bill of Lading Number",
      "required": false,
      "keywords": [
        "bill of lading",
        "b/l no",
        "bl no"
      ],
      "patterns": [
        "\\bB/?L[-\\s#:]?(?:no\\.?|#|:)?\\s*\\d{3,}"
      ]
    }
  ],
  "custom_fields": []
}