# Controls what `gcloud builds submit` uploads as the build context.
# Without this file, gcloud falls back to .gitignore — which excludes models/*.pt, and the image
# would ship with NO weights. This file keeps models/ (and app/src/config) and drops the rest.
.git/
.venv/
__pycache__/
*.pyc

# Not needed for the Streamlit image:
colab/
members/
notebooks/
tests/
clients/
ai_cowork/
presentation/
data/
outputs/
Full Stack/
*.ipynb
*.docx
*.pptx

# Root-only excludes (leading slash = anchored to repo root, so they do NOT match deploy/Dockerfile).
# A bare "Dockerfile"/"requirements.txt" would match at ANY depth and wrongly drop deploy/Dockerfile.
/Dockerfile
/requirements.txt

# NOTE: models/ is intentionally NOT ignored — the trained best.pt weights must be in the context.
# NOTE: deploy/Dockerfile MUST reach Cloud Build (referenced by deploy/cloudbuild.yaml) — never ignore it.
